# Password shared by the caravan members (the "seal").
CARAVANE_MOT_DE_PASSE=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
CARAVANE_SECRET=
# Optional: published CSV URL of the price spreadsheet (Google Sheets > File > Share > Publish to web > CSV).
# When set, it replaces content/marchandises.csv and is re-read every 5 minutes.
CATALOGUE_CSV_URL=
