# Password shared by the caravan members (the "seal"); used when Discord is off, or alongside it.
CARAVANE_MOT_DE_PASSE=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
CARAVANE_SECRET=
# Optional: published CSV URL of the price spreadsheet (Google Sheets > File > Share > Publish to web > CSV).
# When set, it replaces content/marchandises.csv and is re-read every 5 minutes.
CATALOGUE_CSV_URL=
# Optional: order mode and missives — Apps Script web app URL (ends with /exec) and the shared token it
# checks (script property JETON). Without them, sealing an order answers an in-character error and the
# missives say the registre is not linked.
COMMANDES_SCRIPT_URL=
COMMANDES_JETON=
# Optional: La Table des Patriarches (http/https), linked at the top of the Caravane page; empty = no link.
TABLE_PATRIARCHES_URL=
# Optional: members' seals through Discord (see README). All three (and CARAVANE_SECRET) are required to turn it on.
# Who may enter is no longer a variable (lot 1b): the sheet's « Rôles » tab and the « Entrer dans le grimoire » row of
# « Permissions » decide (DISCORD_ROLE_IDS / DISCORD_ROLE_PATRIARCHE are not read any more).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Testers (Missions v2): comma-separated Discord user IDs (digits). A tester holds every permission and opens the
# secret page /permissions; testers come only from here, never from the sheet (same variable as table-patriarches).
TESTEURS_DISCORD_IDS=
# 1 = keep the shared password as a second way in while Discord is on.
SCEAU_MOT_DE_PASSE_COMMUN=
# Development only: point OAuth at a local mock instead of discord.com.
# DISCORD_API_URL=http://localhost:3921/api
# DISCORD_AUTHORIZE_URL=http://localhost:3921/oauth2/authorize
